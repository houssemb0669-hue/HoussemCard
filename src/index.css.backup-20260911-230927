* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  font-family: Arial, "Noto Sans Arabic", sans-serif;
  direction: rtl;
  background:
    radial-gradient(circle at top, #334155 0%, #111827 45%, #020617 100%);
  color: #fff;
}

.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.card {
  width: min(100%, 430px);
  padding: 42px 28px 34px;
  text-align: center;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.09);
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(14px);
}

.icon {
  width: 82px;
  height: 82px;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 42px;
  background: rgba(34, 197, 94, 0.16);
  border: 1px solid rgba(74, 222, 128, 0.3);
}

h1 {
  margin: 0;
  font-size: 32px;
  font-weight: 800;
}

h2 {
  margin: 18px 0 12px;
  font-size: 24px;
  font-weight: 800;
}

p {
  margin: 0 auto 28px;
  max-width: 330px;
  color: #d1d5db;
  font-size: 17px;
  line-height: 1.8;
}

.call-button {
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 16px;
  background: #16a34a;
  color: white;
  text-decoration: none;
  font-size: 19px;
  font-weight: 800;
  box-shadow: 0 8px 20px rgba(22, 163, 74, 0.3);
  transition: 0.2s ease;
}

.call-button:hover {
  transform: translateY(-2px);
  background: #15803d;
}

.call-button:active {
  transform: translateY(0);
}

.future-links {
  margin-top: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #9ca3af;
  font-size: 14px;
}

@media (max-width: 480px) {
  .page {
    padding: 16px;
  }

  .card {
    padding: 34px 20px 28px;
  }

  h1 {
    font-size: 28px;
  }

  h2 {
    font-size: 21px;
  }
}

.whatsapp-button {
  min-height: 58px;
  margin-top: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 16px;
  background: #25d366;
  color: white;
  text-decoration: none;
  font-size: 19px;
  font-weight: 800;
  box-shadow: 0 8px 20px rgba(37, 211, 102, 0.25);
  transition: 0.2s ease;
}

.whatsapp-button:hover {
  transform: translateY(-2px);
  background: #20bd5a;
}

.whatsapp-button:active {
  transform: translateY(0);
}
